{# Attach the necessary library. #}
{{ attach_library('vvjs/vvjs') }}

{# Set view id #}
{% set unique_id = options.unique_id %}
{% set view_id = 'vvjs__slide-wrap-' ~ unique_id %}
{% set slide_id = 'vvjs__itemshow-' ~ unique_id %}

{# Set the classes for the view. #}
{% set classes = [
  'vvjs',
  'vvjs--id--' ~ unique_id,
  view_id,
] %}

{# Slideshow fields #}
{% set pb_prev_next = options.arrows %}
{% set pb_bottom_nav = options.navigation %}
{% set pb_animated_tab = options.animation %}
{% set pb_play_stop = options.time_in_seconds %}

{# Main wrapper #}
<div {{ attributes.addClass(classes).setAttribute('id', view_id) }}>

      {% set total_slides = 0 %}
      <div id="{{ slide_id }}" class="vvjs__inner{{ pb_bottom_nav ? ' ' ~ pb_bottom_nav }}{{ pb_play_stop == 0 ? ' zero' : ' not-zero' }}">
        <div id="vvjs__items-{{ unique_id }}" class="vvjs__items">
          {% for row in rows %}
            {% set total_slides = total_slides + 1 %}
            <div id="vvjs__slide-item-{{ unique_id }}-{{ loop.index }}" role="tabpanel" data-index="{{ loop.index }}" aria-hidden="{% if loop.first %}false{% else %}true{% endif %}" {% if pb_bottom_nav %}aria-labelledby="vvjs__slide-bottom-btn-{{ loop.index }}"{% endif %} class="vvjs__slide-item">
              <div class="vvjs__slide-item-inner{{ pb_animated_tab == '' ? '' : ' ' ~ pb_animated_tab }}" id="{{ slide_id }}-{{ loop.index }}-pane">
                {{ row.content }}
              </div>
            </div>
          {% endfor %}
        </div>

        {% if pb_bottom_nav or pb_play_stop > 0 %}
          <div id="vvjs__slide-nav-{{ unique_id }}" role="tablist" aria-label="Slideshow Tabs" class="vvjs__slide-nav vvjs__slide-number {{ pb_bottom_nav }}">
            {% if pb_play_stop > 0 %}
              <button id="btn-{{ unique_id }}" type="button" role="tab" aria-label="Stop automatic slide show" class="vvjs__button hide-{{ pb_play_stop }} vvjs__play playing" aria-live="polite"><span class="visually-hidden">Play and Stop Slideshow</span>&#10073;&nbsp;&#10073;</button>
            {% endif %}
            {% if pb_bottom_nav %}
              {% for row in rows %}
                <button id="vvjs__slide-bottom-btn-{{ loop.index }}" type="button" role="tab"
                        aria-label="Slide {{ loop.index }}"
                        aria-selected="{% if loop.first %}true{% else %}false{% endif %}"
                        aria-controls="vvjs__slide-item-{{ unique_id }}-{{ loop.index }}"
                        class="vvjs__button vvjs__slide-bottom-btn{% if loop.first %} vvjs__active{% endif %}"
                        {% if not loop.first %}tabindex="-1"{% endif %}>
                  {{ loop.index }}
                </button>
              {% endfor %}
            {% endif %}
          </div>
        {% endif %}

        {% if pb_prev_next %}
          <div id="vvjs__slide-arrows-{{ unique_id }}" class="vvjs__slide-arrows vvjs__prev-next-arrow-{{ pb_prev_next }}" role="navigation" aria-label="Slideshow Navigation">
            <button class="vvjs__prev vvjs__button" role="button" aria-controls="vvjs__items-{{ unique_id }}" aria-label="Previous Slide"><span class="visually-hidden">Previous Slide</span>❮</button>
            <button class="vvjs__next vvjs__button" role="button" aria-controls="vvjs__items-{{ unique_id }}" aria-label="Next Slide"><span class="visually-hidden">Next Slide</span>❯</button>
          </div>
        {% endif %}

        <div class="vvjs__ps-value" aria-hidden="true">
          {{ pb_play_stop }}
        </div>
      </div>


</div>

